# Скопируйте в backend\.env — setup.bat делает это автоматически.
# Файл .env в git не попадает.

APP_NAME=Finance AI
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Путь к базе относительно каталога backend/
DATABASE_PATH=data/finance.db

# Базовая валюта. В MVP поддерживается только RUB.
BASE_CURRENCY=RUB

# --- AI: устаревшая заготовка этапа 0 (не используется) ---
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Локальный AI-помощник (Ollama) ---
# Только локальный сервер: адрес должен быть 127.0.0.1, ::1 или localhost.
# Облачные модели (*:cloud) не поддерживаются. Ключи не нужны.
ASSISTANT_ENABLED=true
ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
ASSISTANT_MODEL=qwen3.5:4b-q4_K_M
ASSISTANT_STATUS_TIMEOUT_SECONDS=3
ASSISTANT_DIGEST_TOKEN_BUDGET=2500
# Чат: лимиты длины и таймауты
ASSISTANT_MAX_QUESTION_CHARS=1000
ASSISTANT_MAX_HISTORY_MESSAGES=8
ASSISTANT_MAX_OUTPUT_TOKENS=700
ASSISTANT_MAX_OUTPUT_CHARS=6000
ASSISTANT_CONTEXT_WINDOW_TOKENS=8192
ASSISTANT_CHUNK_TIMEOUT_SECONDS=120
ASSISTANT_TOTAL_TIMEOUT_SECONDS=300

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
