# Скопируйте в backend\.env — setup.bat делает это автоматически.
# Файл .env в git не попадает.

APP_NAME=Finance AI
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Путь к базе относительно каталога backend/
DATABASE_PATH=data/finance.db

# Базовая валюта. В MVP поддерживается только RUB.
BASE_CURRENCY=RUB

# --- AI (подключается на этапе 6) ---
# Ключ читается только backend и никогда не передаётся во frontend.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
